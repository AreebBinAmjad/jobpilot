# Copy to .env, then replace every "change-me" with its own value from:
#   openssl rand -hex 32
# Use hex values: these passwords also go inside connection URLs.

# --- JobPilot database (Postgres + pgvector) ---
JOBPILOT_DB_PASSWORD=change-me
# Used by the apps. Put the same password here.
DATABASE_URL=postgresql://jobpilot:change-me@localhost:5433/jobpilot

# --- Langfuse services (only used inside Docker) ---
LANGFUSE_DB_PASSWORD=change-me
NEXTAUTH_SECRET=change-me
SALT=change-me
ENCRYPTION_KEY=change-me
CLICKHOUSE_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
REDIS_AUTH=change-me

# --- Langfuse project keys (create in the Langfuse UI: project settings > API keys) ---
LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- LLM providers (add the ones you use) ---
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
